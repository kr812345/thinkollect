# Copy to .env and fill in. NEVER commit the real .env.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key (Settings -> API -> service_role). Required: the backend
# writes on behalf of users and bypasses RLS (user scoping is in app code).
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the backend's own JWTs. Generate a long random string,
# e.g.: openssl rand -hex 32
JWT_SECRET=

# Minutes until an access token expires (default: 30 days).
TOKEN_EXPIRY_MINUTES=43200

# Sentence-transformers model used for embeddings (384-dim expected by DB).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI-compatible LLM (OpenAI, Groq, OpenRouter, Ollama, ...).
# Insights are skipped if LLM_API_KEY is empty; chat returns 503.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Comma-separated CORS origins. Use "*" only for local development.
CORS_ORIGINS=*

# Max signup/login attempts per IP per minute (0 disables).
RATE_LIMIT_PER_MINUTE=10
# Max chat messages per IP per minute (0 disables).
CHAT_RATE_LIMIT_PER_MINUTE=20
