[Unit]
Description=Thinkollect API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/thinkollect/apps/api
EnvironmentFile=-/opt/thinkollect/apps/api/.env
ExecStart=/opt/thinkollect/apps/api/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
